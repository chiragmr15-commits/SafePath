# SafePath AI - Environment Configuration
# Copy this file to .env and update with your actual values

# SMS Service Configuration
# Choose one: twilio, fast2sms, or textbelt
SMS_SERVICE=configure_your_sms_service_here

# Twilio Configuration (if using Twilio)
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=your_phone_number_here

# Fast2SMS Configuration (if using Fast2SMS)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Note: TextBelt is free and doesn't require configuration
# It's the default SMS service. Other services are optional.

# Django Secret Key
# SECURITY WARNING: keep the secret key used in production secret!
SECRET_KEY=your-secret-key-here

# Debug Mode
DEBUG=True

# Database Configuration
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Allowed Hosts
ALLOWED_HOSTS = [
    'localhost',
    '127.0.0.1',
    '.onrender.com',
    'safepath-2-r2e2.onrender.com',
]

# Email Configuration (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-password
